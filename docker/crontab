# crossword-app scraper schedule
# All times are in the container's TZ (see docker-compose.yml -> TZ=America/New_York),
# since that's the timezone NYT actually resets puzzles in.
#
# min  hour  dom  month  dow  user  command

# Wordle flips at midnight local time (which is around 5pm ET)
# Run at 17:10 to give their systems a few minutes of buffer.
10  18  *  *  *  /app/scripts/wordle_daily.sh >> /app/data/logs/cron.log 2>&1

# Crosswords:
# Run early at 18:10 on Saturday (gets Sunday's puzzle) and Sunday (gets Monday's puzzle)
10  18  *  *  6,0  /app/scripts/crosswords_daily.sh >> /app/data/logs/cron.log 2>&1
# Run at 22:10 Monday through Friday (gets Tuesday through Saturday's puzzles)
10  22  *  *  1-5  /app/scripts/crosswords_daily.sh >> /app/data/logs/cron.log 2>&1

# Spelling Bee: NYT resets this one at 3am ET specifically.
10  3  *  *  *  /app/scripts/spelling_bee_daily.sh >> /app/data/logs/cron.log 2>&1

# Weekly xwords archive pull from your GitHub repo, every Sunday at 1pm ET.
# 0  13  *  *  0  /app/scripts/weekly_xwords_pull.sh >> /app/data/logs/cron.log 2>&1

# Required trailing newline for cron
